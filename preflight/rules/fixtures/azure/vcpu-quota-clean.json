{
  "_base": "clean.json",
  "_note": "the regional vCPU quota covers the 12 vCPUs of the pools",
  "_patch": {
    "_responses": {
      "GET /v1/clouds/azure/regions/eastus/instancetypes?cloudAccountUid=acc-azure-1&subscriptionId=11111111-2222-3333-4444-555555555555&cpuGtEq=0&memoryGtEq=0": {
        "ok": true,
        "status": 200,
        "body": {
          "instanceTypes": [
            { "category": "General purpose", "cpu": 4, "memory": 16, "type": "Standard_D4s_v3", "nonSupportedZones": null, "supportedArchitectures": ["x64"] },
            { "category": "General purpose", "cpu": 1, "memory": 1, "type": "Standard_B1s", "nonSupportedZones": null, "supportedArchitectures": ["x64"] }
          ]
        }
      }
    }
  },
  "_exec": {
    "az vm list-usage --location eastus --subscription 11111111-2222-3333-4444-555555555555 --output json": {
      "exit": 0,
      "stdout": [
        {
          "currentValue": 8,
          "limit": 100,
          "name": {
            "localizedValue": "Total Regional vCPUs",
            "value": "cores"
          }
        },
        {
          "currentValue": 0,
          "limit": 100,
          "name": {
            "localizedValue": "Standard DSv3 Family vCPUs",
            "value": "standardDSv3Family"
          }
        },
        {
          "currentValue": 3,
          "limit": 2500,
          "name": {
            "localizedValue": "Virtual Machines",
            "value": "virtualMachines"
          }
        }
      ],
      "stderr": ""
    }
  }
}
