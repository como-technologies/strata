          }
        },
        {
          "currentValue": 0,
          "limit": 10,
          "name": {
            "localizedValue": "Standard DSv3 Family vCPUs",
            "value": "standardDSv3Family"
          }
        },
        {
          "currentValue": 3,
          "limit": 2500,
          "name": {
            "localizedValue": "Virtual Machines",
            "value": "virtualMachines"
          }
        }
      ],
      "stderr": ""
    }
  }
}
