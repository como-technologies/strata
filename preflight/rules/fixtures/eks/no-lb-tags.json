{
  "_base": "static-vpc-clean.json",
  "_note": "the subnets carry no kubernetes.io/role/elb or internal-elb tag",
  "_patch": {
    "_exec": {
      "aws ec2 describe-subnets --region us-east-2 --filters Name=subnet-id,Values=subnet-0aaa,subnet-0bbb --output json": {
        "exit": 0,
        "stdout": {
          "Subnets": [
            {
              "SubnetId": "subnet-0aaa",
              "VpcId": "vpc-0a1b2c3d4e5f60718",
              "AvailabilityZone": "us-east-2a",
              "AvailabilityZoneId": "use2-az1",
              "CidrBlock": "10.10.0.0/24",
              "AvailableIpAddressCount": 240,
              "MapPublicIpOnLaunch": true,
              "Tags": [
                {
                  "Key": "Name",
                  "Value": "lab-public-a"
                }
              ]
            },
            {
              "SubnetId": "subnet-0bbb",
              "VpcId": "vpc-0a1b2c3d4e5f60718",
              "AvailabilityZone": "us-east-2b",
              "AvailabilityZoneId": "use2-az2",
              "CidrBlock": "10.10.1.0/24",
              "AvailableIpAddressCount": 240,
              "MapPublicIpOnLaunch": false,
              "Tags": []
            }
          ]
        },
        "stderr": ""
      }
    }
  }
}
