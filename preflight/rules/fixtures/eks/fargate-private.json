{
  "_base": "clean.json",
  "_note": "a Fargate profile names two subnets, and their route table routes 0.0.0.0/0 to a NAT gateway",
  "_patch": {
    "entity": {
      "spec": {
        "cloudConfig": { "vpcId": "vpc-0a1b2c3d4e5f60718" },
        "fargateProfiles": [
          { "name": "fp-1", "subnetIds": ["subnet-0aaa1111bbbb2222c", "subnet-0bbb2222cccc3333d"], "selectors": [ { "namespace": "default" } ] }
        ]
      }
    },
    "_exec": {
      "aws ec2 describe-route-tables --region us-east-2 --filters Name=association.subnet-id,Values=subnet-0aaa1111bbbb2222c,subnet-0bbb2222cccc3333d --output json": {
        "exit": 0,
        "stdout": {
          "RouteTables": [
            {
              "RouteTableId": "rtb-0private000000001",
              "Associations": [
                { "SubnetId": "subnet-0aaa1111bbbb2222c", "RouteTableId": "rtb-0private000000001" },
                { "SubnetId": "subnet-0bbb2222cccc3333d", "RouteTableId": "rtb-0private000000001" }
              ],
              "Routes": [
                { "DestinationCidrBlock": "10.0.0.0/16", "GatewayId": "local", "State": "active" },
                { "DestinationCidrBlock": "0.0.0.0/0", "NatGatewayId": "nat-0abc1234def567890", "State": "active" }
              ]
            }
          ]
        },
        "stderr": ""
      }
    }
  }
}
