              "EvalDecision": "allowed"
            },
            {
              "EvalActionName": "eks:DescribeNodegroup",
              "EvalResourceName": "*",
              "EvalDecision": "allowed"
            },
            {
              "EvalActionName": "iam:GetRole",
              "EvalResourceName": "*",
