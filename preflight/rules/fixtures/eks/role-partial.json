{
  "_base": "identity-clean.json",
  "_note": "the role can describe and not create: eks:CreateNodegroup and iam:PassRole are denied; ec2:RunInstances is denied too, and EKS does not call it",
  "_patch": {
    "_exec": {
      "aws iam simulate-principal-policy --policy-source-arn arn:aws:iam::123456789012:role/strata-live-eks-cloud --action-names ec2:CreateSecurityGroup ec2:AuthorizeSecurityGroupIngress iam:PassRole ec2:DescribeKeyPairs ec2:DescribeImages ec2:RunInstances elasticloadbalancing:CreateLoadBalancer ec2:CreateVpc ec2:CreateSubnet ec2:CreateInternetGateway ec2:CreateRouteTable ec2:CreateNatGateway ec2:AllocateAddress eks:CreateCluster eks:CreateNodegroup eks:DescribeCluster eks:DescribeNodegroup iam:GetRole iam:ListAttachedRolePolicies cloudformation:DescribeStacks --output json": {
        "exit": 0,
        "stdout": {
          "EvaluationResults": [
            {
              "EvalActionName": "ec2:CreateSecurityGroup",
              "EvalResourceName": "*",
              "EvalDecision": "allowed"
            },
            {
              "EvalActionName": "ec2:AuthorizeSecurityGroupIngress",
              "EvalResourceName": "*",
              "EvalDecision": "allowed"
            },
            {
              "EvalActionName": "iam:PassRole",
              "EvalResourceName": "*",
              "EvalDecision": "explicitDeny"
            },
            {
