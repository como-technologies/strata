{
  "_base": "clean.json",
  "_note": "the on-demand vCPU quota is 64, and the pools ask for 12 (3 x t3.xlarge)",
  "_patch": {
    "_responses": {
      "GET /v1/clouds/aws/regions/us-east-2/instancetypes?cloudAccountUid=acc-aws-1": {
        "ok": true,
        "status": 200,
        "body": {
          "instanceTypes": [
            { "category": "General purpose", "cpu": 4, "memory": 16, "type": "t3.xlarge", "nonSupportedZones": null, "supportedArchitectures": ["x86_64"] },
            { "category": "General purpose", "cpu": 8, "memory": 32, "type": "m5.2xlarge", "nonSupportedZones": null, "supportedArchitectures": ["x86_64"] }
          ]
        }
      }
    },
    "_exec": {
      "aws service-quotas get-service-quota --service-code ec2 --quota-code L-1216C47A --region us-east-2 --output json": {
        "exit": 0,
        "stdout": {
          "Quota": { "ServiceCode": "ec2", "QuotaCode": "L-1216C47A", "QuotaName": "Running On-Demand Standard (A, C, D, H, I, M, R, T, Z) instances", "Value": 64.0, "Unit": "None", "Adjustable": true }
        },
        "stderr": ""
      }
    }
  }
}
