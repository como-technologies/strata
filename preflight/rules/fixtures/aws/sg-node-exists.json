{
  "_base": "static-vpc-clean.json",
  "_note": "a security group fred-node is in the VPC already",
  "_patch": {
    "_exec": {
      "aws ec2 describe-security-groups --region us-east-2 --filters Name=vpc-id,Values=vpc-0a1b2c3d4e5f60718 Name=group-name,Values=fred-node,fred-controlplane,fred-apiserver-lb,fred-lb,fred-bastion --output json": {
        "exit": 0,
        "stdout": {
          "SecurityGroups": [
            {
              "GroupName": "fred-node",
              "GroupId": "sg-0f00ba4",
              "VpcId": "vpc-0a1b2c3d4e5f60718",
              "Description": "left from an earlier cluster"
            }
          ]
        },
        "stderr": ""
      }
    }
  }
}
