{
  "_base": "clean.json",
  "_note": "static placement: a VPC and one subnet for both pools, with no security group of the cluster in it yet",
  "_patch": {
    "entity": {
      "spec": {
        "cloudConfig": {
          "vpcId": "vpc-0a1b2c3d4e5f60718"
        },
        "machinepoolconfig": [
          {
            "cloudConfig": {
              "subnets": [
                {
                  "az": "us-east-2a",
                  "id": "subnet-0aaa"
                }
              ]
            },
            "poolConfig": {
              "name": "cp-pool"
            }
          },
          {
            "cloudConfig": {
