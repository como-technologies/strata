                {
                  "az": "us-east-2a",
                  "id": "subnet-0aaa"
                }
              ]
            },
            "poolConfig": {
              "name": "worker-pool"
            }
          }
        ]
      }
    },
    "_exec": {
      "aws ec2 describe-security-groups --region us-east-2 --filters Name=vpc-id,Values=vpc-0a1b2c3d4e5f60718 Name=group-name,Values=fred-node,fred-controlplane,fred-apiserver-lb,fred-lb,fred-bastion --output json": {
        "exit": 0,
        "stdout": {
