#!/usr/bin/env bash
# palette-profile-diff: Merkle-style diff of two Spectro Cloud Palette cluster profiles.
#
# Every pack on a profile gets three sub-hashes so the report can say WHICH KIND of
# change happened, not just that something did:
#   identity  name/layer/type/tag/version/packUid/registryUid  -> "someone bumped the pack"
#   upstream  the digest Palette stamps on the pack ref (registry content)
#                                                          -> "same tag, content moved under the hood"
#   authored  canonical values YAML + attached manifest contents + params
#                                                          -> "someone edited values/manifests"
#   node = sha256(identity + upstream + authored)
#   root = sha256(variablesHash, [key, node] in profile order)
#
# Deps: bash 4+, curl, jq 1.6+, python3 with PyYAML (YAML -> canonical JSON, sha256).
set -euo pipefail

VERSION="0.1.0"
API="${PALETTE_API:-https://api.spectrocloud.com}"
PROG="${0##*/}"

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
log() { [ -n "${PPD_QUIET:-}" ] || printf '%s\n' "$*" >&2; }

# Color: --color=auto (default) means "stdout is a terminal", honoring NO_COLOR and CLICOLOR_FORCE.
COLOR=auto
ESC=$(printf '\033')
set_color() {
  case $1 in auto|always|never) COLOR=$1 ;; *) die "--color takes auto, always, or never" ;; esac
}
color_on() {
  case $COLOR in always) return 0 ;; never) return 1 ;; esac
  [ -n "${NO_COLOR:-}" ] && return 1
  [ -n "${CLICOLOR_FORCE:-}" ] && return 0
  [ -t 1 ]
}
paint() { # sgr-code text
  if color_on; then printf '%s[%sm%s%s[0m' "$ESC" "$1" "$2" "$ESC"; else printf '%s' "$2"; fi
}

usage() {
  cat <<EOF
$PROG $VERSION - diff two Palette cluster profiles, Merkle style

Usage:
  $PROG <A> <B> [--json] [--full]          compare (same as "compare")
  $PROG compare <A> <B> [--json] [--full]
  $PROG snapshot <ref> [-o FILE] [--raw-dir DIR]
  $PROG snapshot --from-raw DIR [-o FILE]
  $PROG verify <snapshot.json> [--json]     re-fetch the same uid; exit 1 if the published version drifted

<A>, <B>, <ref> may be:
  <uid>                 a cluster profile uid
  <name>@<version>      resolved via /v1/dashboard/clusterprofiles/metadata
  path/to/snapshot.json a snapshot written earlier by "$PROG snapshot"

Options:
  --json       print the machine-readable diff instead of the text report
  --full       also print unified diffs of raw values and changed manifests
  --color[=auto|always|never], --no-color
               color the report; auto (default) colors only when stdout is a terminal
               and honors NO_COLOR and CLICOLOR_FORCE
  -o FILE      write the snapshot to FILE instead of stdout
  --raw-dir D  save the raw API responses under D (profile/manifests/variables.json)
  --from-raw D build a snapshot from raw API responses saved under D (offline)

Environment:
  PALETTE_API_KEY       required for live refs
  PALETTE_PROJECT_UID   sent as the ProjectUid header when set (project-scoped profiles)
  PALETTE_API           API base, default https://api.spectrocloud.com

Exit status: 0 identical (verify: unchanged), 1 different (verify: drifted), 2 error.
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
check_deps() {
  need curl; need jq; need python3
  python3 -c 'import yaml' 2>/dev/null || die "python3 needs PyYAML (apt install python3-yaml, or pip install pyyaml)"
}

# ---------------------------------------------------------------- API helpers
api_get() {
  local path=$1
  [ -n "${PALETTE_API_KEY:-}" ] || die "PALETTE_API_KEY is required to fetch '$path'"
  local -a hdr=(-H "ApiKey: ${PALETTE_API_KEY}" -H 'Accept: application/json')
  [ -n "${PALETTE_PROJECT_UID:-}" ] && hdr+=(-H "ProjectUid: ${PALETTE_PROJECT_UID}")
  curl -sS --fail-with-body "${hdr[@]}" "${API}${path}"
}

resolve_uid() {
  local ref=$1 uid
  case $ref in
    *@*)
      local name=${ref%@*} ver=${ref##*@}
      uid=$(api_get "/v1/dashboard/clusterprofiles/metadata" \
        | jq -r --arg n "$name" --arg v "$ver" \
            '[.items[] | select(.metadata.name == $n and .spec.version == $v)] | .[0].metadata.uid // empty')
      [ -n "$uid" ] || die "no cluster profile named '$name' with version '$ver' in this scope"
      printf '%s' "$uid" ;;
    *) printf '%s' "$ref" ;;
  esac
}

fetch_json() { # path outfile
  if ! api_get "$1" > "$2"; then
    die "GET $1 failed: $(head -c 300 "$2" 2>/dev/null | tr -d '\n')"
  fi
}

fetch_raw() { # uid dir
  local uid=$1 dir=$2
  mkdir -p "$dir"
  log "fetching profile $uid"
  fetch_json "/v1/clusterprofiles/${uid}" "$dir/profile.json"
  fetch_json "/v1/clusterprofiles/${uid}/packs/manifests" "$dir/manifests.json"
  if ! api_get "/v1/clusterprofiles/${uid}/variables" > "$dir/variables.json" 2>/dev/null; then
    log "note: variables endpoint unavailable for $uid, treating as none"
    printf '{"variables":[]}\n' > "$dir/variables.json"
  fi
}

# ---------------------------------------------------------------- jq: raw API -> pre-snapshot
JQ_EXTRACT=$(cat <<'JQ'
($p[0]) as $prof
| (($m[0].spec.packs) // []) as $mp
| (($v[0].variables) // []) as $vars
| (if (($prof.spec.published.packs // []) | length) > 0
   then {tpl: $prof.spec.published, state: "published"}
   else {tpl: ($prof.spec.draft // {}), state: "draft"} end) as $t
| {
    source: {
      ref: $ref,
      uid: ($prof.metadata.uid // ""),
      name: ($prof.metadata.name // ""),
      version: ($prof.spec.version // ""),
      cloudType: ($t.tpl.cloudType // ""),
      type: ($t.tpl.type // ""),
      template: $t.state,
      tags: ($prof.metadata.labels // {}),
      consumers: {
        clusters: ($prof.status.inUseClusterUids // []),
        count: (($prof.status.inUseClusterUids // []) | length)
      },
      fetchedAt: $now
    },
    variables: ([ $vars[] | {
        name,
        displayName: (.displayName // ""),
        description: (.description // ""),
        format: (.format // "string"),
        defaultValue: (.defaultValue // ""),
        regex: (.regex // ""),
        required: (.required // false),
        immutable: (.immutable // false),
        hidden: (.hidden // false),
        isSensitive: (.isSensitive // false),
        inputType: (.inputType // "text"),
        options: [ (.options // [])[] | {label: (.label // ""), value: (.value // ""), description: (.description // "")} ]
      } ] | sort_by(.name)),
    packs: [ ($t.tpl.packs // [])[] | . as $pk
      | (($mp | map(select(.metadata.name == $pk.name or .spec.name == $pk.name)) | .[0]) // {}) as $mm
      | {
          key: "\($pk.layer // "addon")/\($pk.name)",
          layer: ($pk.layer // "addon"),
          name: $pk.name,
          type: ($pk.type // "spectro"),
          tag: ($pk.tag // ""),
          version: ($pk.version // $mm.spec.version // ""),
          packUid: ($pk.packUid // ""),
          registryUid: ($pk.registryUid // ""),
          refDigest: ($pk.digest // ""),
          registryDigest: ($mm.spec.digest // ""),
          params: ($pk.params // {}),
          values: ($pk.values // $mm.spec.values // ""),
          manifests: ([ ($mm.spec.manifests // [])[]
                        | {name, uid: (.uid // ""), digest: (.digest // ""), content: (.content // "")} ]
                      | sort_by(.name))
        } ]
  }
JQ
)

# ---------------------------------------------------------------- python: canonical form + hashes
PY_CANON=$(cat <<'PY'
import sys, json, hashlib
import yaml

tool_version = sys.argv[1]

def norm(o):
    if isinstance(o, dict):
        return {str(k): norm(v) for k, v in o.items()}
    if isinstance(o, list):
        return [norm(x) for x in o]
    if isinstance(o, (str, int, float, bool)) or o is None:
        return o
    return str(o)

def cj(o):
    return json.dumps(o, sort_keys=True, separators=(",", ":"), ensure_ascii=False)

def h(s):
    return hashlib.sha256(s.encode("utf-8")).hexdigest()

def canon_yaml(text):
    if text is None or text.strip() == "":
        return {"ok": True, "doc": None}
    try:
        docs = [norm(d) for d in yaml.safe_load_all(text)]
        # zero documents (comment-only text) is "no values", the same as empty text
        return {"ok": True, "doc": None if not docs else (docs[0] if len(docs) == 1 else docs)}
    except Exception as e:
        return {"ok": False, "error": str(e).splitlines()[0][:200]}

snap = json.load(sys.stdin)

for p in snap["packs"]:
    c = canon_yaml(p.get("values", ""))
    if c["ok"]:
        p["valuesCanon"] = c["doc"]
        p["valuesHash"] = h(cj(c["doc"]))
    else:
        p["valuesCanon"] = None
        p["valuesParseError"] = c["error"]
        p["valuesHash"] = h(p["values"].strip())
    for m in p["manifests"]:
        c = canon_yaml(m.get("content", ""))
        if c["ok"]:
            m["contentHash"] = h(cj(c["doc"]))
        else:
            m["contentHash"] = h(m["content"].strip())
            m["contentParseError"] = c["error"]

    identity = h(cj({k: p.get(k, "") for k in
                     ("name", "layer", "type", "tag", "version", "packUid", "registryUid")}))
    if p.get("refDigest"):
        up, src = p["refDigest"], "packRef.digest"
    elif p.get("registryDigest"):
        up, src = p["registryDigest"], "packSummary.digest"
    else:
        up, src = "", "none"
    upstream = h(up)
    authored = h(cj({
        "values": p["valuesHash"],
        "manifests": [[m["name"], m["contentHash"]] for m in p["manifests"]],
        "params": p.get("params") or {},
    }))
    p["hash"] = {
        "identity": identity,
        "upstream": upstream,
        "upstreamRaw": up,
        "upstreamSource": src,
        "authored": authored,
        "node": h(identity + upstream + authored),
    }

snap["variablesHash"] = h(cj(snap.get("variables") or []))
snap["root"] = h(cj({
    "variables": snap["variablesHash"],
    "packs": [[p["key"], p["hash"]["node"]] for p in snap["packs"]],
}))
snap["schema"] = "palette-profile-snapshot/1"
snap["tool"] = {"name": "palette-profile-diff", "version": tool_version}
json.dump(snap, sys.stdout, indent=1, sort_keys=True, ensure_ascii=False)
sys.stdout.write("\n")
PY
)

# ---------------------------------------------------------------- jq: two snapshots -> diff JSON
JQ_DIFF=$(cat <<'JQ'
def leaves:
  . as $doc
  | if type == "object" or type == "array" then
      reduce paths(type != "object" and type != "array") as $p ({};
        . + { ($p | map(if type == "number" then "[\(.)]" else tostring end) | join(".") | gsub("\\.\\["; "[")): ($doc | getpath($p)) })
    else {} end;

def vdiff($x; $y):
  ($x | leaves) as $lx | ($y | leaves) as $ly
  | [ ((($lx | keys) + ($ly | keys)) | unique)[] as $k
      | if ($lx | has($k)) and ($ly | has($k)) then
          (if $lx[$k] == $ly[$k] then empty else {op: "~", path: $k, old: $lx[$k], new: $ly[$k]} end)
        elif ($lx | has($k)) then {op: "-", path: $k, old: $lx[$k]}
        else {op: "+", path: $k, new: $ly[$k]} end ];

def blast($layer; $id; $au; $up):
  if $layer == "os" and $id then "node repave (OS image change)"
  elif $layer == "k8s" and $id then "node repave (Kubernetes version change)"
  elif ($layer == "os" or $layer == "k8s") and $au then "node/control plane config change, may repave"
  elif ($layer == "cni" or $layer == "csi") and ($id or $au) then "cluster-wide infra addon update"
  elif $id or $au then "in-place addon upgrade"
  elif $up then "pack content changed under the same tag, applied on next profile sync"
  else "" end;

def byname(f): map({(f): .}) | add // {};

($sa[0]) as $a | ($sb[0]) as $b
| ($a.packs | byname(.key)) as $pa
| ($b.packs | byname(.key)) as $pb
| ((($pa | keys) + ($pb | keys)) | unique) as $keys
| {
    tool: "palette-profile-diff",
    a: $a.source, b: $b.source,
    rootA: $a.root, rootB: $b.root,
    same: ($a.root == $b.root),
    variables: {
      changed: ($a.variablesHash != $b.variablesHash),
      diff: vdiff(($a.variables | byname(.name)); ($b.variables | byname(.name)))
    },
    orderChanged: (
      ([$a.packs[].key] | map(select(. as $k | $pb | has($k)))) !=
      ([$b.packs[].key] | map(select(. as $k | $pa | has($k))))
    ),
    packs: [ $keys[] as $k | $pa[$k] as $x | $pb[$k] as $y
      | if $x == null then
          {key: $k, status: "added", layer: $y.layer, name: $y.name,
           b: {tag: $y.tag, version: $y.version, packUid: $y.packUid, registryUid: $y.registryUid}}
        elif $y == null then
          {key: $k, status: "removed", layer: $x.layer, name: $x.name,
           a: {tag: $x.tag, version: $x.version, packUid: $x.packUid, registryUid: $x.registryUid}}
        else
          ($x.hash.identity != $y.hash.identity) as $id
          | ($x.hash.upstream != $y.hash.upstream) as $up
          | ($x.hash.authored != $y.hash.authored) as $au
          | ($x.manifests | byname(.name) | map_values(.contentHash)) as $mx
          | ($y.manifests | byname(.name) | map_values(.contentHash)) as $my
          | {
              key: $k,
              status: (if $x.hash.node == $y.hash.node then "unchanged" else "changed" end),
              layer: $x.layer, name: $x.name,
              a: {tag: $x.tag, version: $x.version, packUid: $x.packUid, registryUid: $x.registryUid,
                  upstream: $x.hash.upstreamRaw, upstreamSource: $x.hash.upstreamSource},
              b: {tag: $y.tag, version: $y.version, packUid: $y.packUid, registryUid: $y.registryUid,
                  upstream: $y.hash.upstreamRaw, upstreamSource: $y.hash.upstreamSource},
              identity: $id, upstream: $up, authored: $au,
              valuesChanged: ($x.valuesHash != $y.valuesHash),
              valuesTextOnly: (($x.valuesParseError // $y.valuesParseError) != null),
              valuesDiff: (if $x.valuesHash != $y.valuesHash and $x.valuesCanon != null and $y.valuesCanon != null
                           then vdiff($x.valuesCanon; $y.valuesCanon) else [] end),
              manifests: [ ((($mx | keys) + ($my | keys)) | unique)[] as $n
                           | if ($mx | has($n)) and ($my | has($n)) then
                               (if $mx[$n] == $my[$n] then empty else {op: "~", name: $n} end)
                             elif ($mx | has($n)) then {op: "-", name: $n}
                             else {op: "+", name: $n} end ],
              blast: blast($x.layer; $id; $au; $up)
            }
        end ]
  }
JQ
)

# ---------------------------------------------------------------- jq: diff JSON -> text report
JQ_RENDER=$(cat <<'JQ'
def esc(code): if $color then $esc + "[" + code + "m" + . + $esc + "[0m" else . end;
def bold: esc("1");      def dim: esc("2");
def red: esc("31");      def green: esc("32");    def yellow: esc("33");
def blue: esc("34");     def magenta: esc("35");  def cyan: esc("36");
def bred: esc("1;31");   def bgreen: esc("1;32"); def byellow: esc("1;33");

def short: if . == null or . == "" then "-" else .[0:12] end;
def rank: ({"os": 0, "k8s": 1, "cni": 2, "csi": 3, "addon": 4}[.]) // 9;
def rpad(n): tostring | if length >= n then . else . + (" " * (n - length)) end;
def show: tojson | if length > 120 then .[0:100] + "... (\(length) chars, see --full)" else . end;
def opmark: if . == "~" then ("~" | yellow) elif . == "+" then ("+" | green) elif . == "-" then ("-" | red) else . end;
def flags: [ (select(.identity) | "IDENTITY" | blue), (select(.upstream) | "UPSTREAM" | magenta), (select(.authored) | "AUTHORED" | yellow) ] | join(" ");
def vline:
  "\(.op | opmark) \(.path)"
  + (if .op == "~" then ": \(.old | show | red) -> \(.new | show | green)"
     elif .op == "+" then ": \(.new | show | green)"
     else ": \(.old | show | red)" end);
def impact:
  if test("repave") then bred
  elif test("cluster-wide") then yellow
  elif test("in-place") then cyan
  else dim end;

def packline:
  (if .status == "added" then "+" elif .status == "removed" then "-" elif .status == "changed" then "~" else " " end) as $m
  | (if .status == "added" then .b.version
     elif .status == "removed" then .a.version
     elif .identity and (.a.version != .b.version) then "\(.a.version) -> \(.b.version)"
     else .a.version end) as $ver
  | if .status == "unchanged" then
      ("  [\(.layer | rpad(5))] \(.name | rpad(26)) \($ver | rpad(18)) unchanged" | dim)
    else
      (if .status == "added" then ("ADDED" | bgreen)
       elif .status == "removed" then ("REMOVED" | bred)
       else flags end) as $st
      | "\($m | opmark) [\(.layer | rpad(5))] \(.name | rpad(26) | bold) \($ver | rpad(18)) \($st)"
    end;

def packdetail:
  (select(.upstream == true)
     | "      upstream digest  \(.a.upstream | short | red) -> \(.b.upstream | short | green)   \("(\(.b.upstreamSource))" | dim)"),
  (select(.valuesChanged == true and ((.valuesDiff // []) | length) > 0)
     | "      values: \(.valuesDiff | map(select(.op == "~")) | length) changed, \(.valuesDiff | map(select(.op == "+")) | length) added, \(.valuesDiff | map(select(.op == "-")) | length) removed",
       (.valuesDiff[] | "        " + vline)),
  (select(.valuesChanged == true and .valuesTextOnly == true)
     | ("      values changed (not parseable as YAML on one side; use --full for a unified diff)" | yellow)),
  ((.manifests // [])[] | "      \(.op | opmark) manifest \(.name)"),
  (select((.blast // "") != "") | "      impact: " + (.blast | impact));

[
  "\(.a.name | bold)@\(.a.version | bold) (\(.a.uid // "-" | dim))  ->  \(.b.name | bold)@\(.b.version | bold) (\(.b.uid // "-" | dim))",
  "root       \(.rootA | short | dim) -> \(.rootB | short | dim)   \(if .same then ("IDENTICAL" | bgreen) else ("CHANGED" | bred) end)",
  "consumers  \(.a.consumers.count // 0) -> \(.b.consumers.count // 0) clusters",
  "",
  "  variables \(if .variables.changed then ("CHANGED" | byellow) else ("unchanged" | dim) end)",
  (.variables.diff[] | "        " + vline),
  "",
  (.packs | sort_by([(.layer | rank), .name])[] | packline, packdetail),
  (select(.orderChanged) | "", ("  note: pack order changed between the two profiles" | yellow))
] | .[]
JQ
)

# ---------------------------------------------------------------- commands
build_snapshot() { # rawdir ref
  local dir=$1 ref=$2
  for f in profile.json manifests.json variables.json; do
    [ -s "$dir/$f" ] || die "missing or empty $dir/$f"
  done
  jq -n --arg now "$(date -u +%FT%TZ)" --arg ref "$ref" \
     --slurpfile p "$dir/profile.json" --slurpfile m "$dir/manifests.json" --slurpfile v "$dir/variables.json" \
     "$JQ_EXTRACT" \
  | python3 -c "$PY_CANON" "$VERSION"
}

# Turn a ref into a snapshot file path in $SNAP (may write into $TMP). Sets a global rather
# than echoing so that die() inside the fetch path exits the script instead of a subshell.
snapshot_for() { # ref -> $SNAP
  local ref=$1
  if [ -f "$ref" ]; then
    jq -e '.schema == "palette-profile-snapshot/1"' "$ref" >/dev/null 2>&1 \
      || die "'$ref' is not a palette-profile-diff snapshot"
    SNAP=$ref; return
  fi
  local uid; uid=$(resolve_uid "$ref") || exit $?
  local dir="$TMP/raw-$uid"
  fetch_raw "$uid" "$dir"
  build_snapshot "$dir" "$ref" > "$TMP/snap-$uid.json" || die "could not build snapshot for $ref"
  SNAP="$TMP/snap-$uid.json"
}

cmd_snapshot() {
  local ref="" out="" rawdir="" fromraw=""
  while [ $# -gt 0 ]; do
    case $1 in
      -o) out=${2:?-o needs a file}; shift 2 ;;
      --raw-dir) rawdir=${2:?--raw-dir needs a dir}; shift 2 ;;
      --from-raw) fromraw=${2:?--from-raw needs a dir}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$ref" ] || die "unexpected argument: $1"; ref=$1; shift ;;
    esac
  done
  local dir
  if [ -n "$fromraw" ]; then
    dir=$fromraw; ref=${ref:-$fromraw}
  else
    [ -n "$ref" ] || die "snapshot needs a profile ref or --from-raw DIR"
    local uid; uid=$(resolve_uid "$ref") || exit $?
    dir=${rawdir:-$TMP/raw-$uid}
    fetch_raw "$uid" "$dir"
  fi
  if [ -n "$out" ]; then
    build_snapshot "$dir" "$ref" > "$out"
    log "wrote $out (root $(jq -r '.root[0:12]' "$out"))"
  else
    build_snapshot "$dir" "$ref"
  fi
}

full_diffs() { # snapA snapB diffJson
  local a=$1 b=$2 d=$3 key name
  local -a dopt=(-u)
  if color_on && diff --color=always /dev/null /dev/null >/dev/null 2>&1; then dopt+=(--color=always); fi
  jq -r '.packs[] | select(.status == "changed") | select(.valuesChanged or ((.manifests | length) > 0)) | .key' "$d" \
  | while IFS= read -r key; do
      if [ "$(jq -r --arg k "$key" '.packs[] | select(.key == $k) | .valuesChanged' "$d")" = true ]; then
        echo
        diff "${dopt[@]}" --label "a: $key values" --label "b: $key values" \
          <(jq -r --arg k "$key" '.packs[] | select(.key == $k) | .values' "$a") \
          <(jq -r --arg k "$key" '.packs[] | select(.key == $k) | .values' "$b") || true
      fi
      jq -r --arg k "$key" '.packs[] | select(.key == $k) | .manifests[] | select(.op == "~") | .name' "$d" \
      | while IFS= read -r name; do
          echo
          diff "${dopt[@]}" --label "a: $key manifest $name" --label "b: $key manifest $name" \
            <(jq -r --arg k "$key" --arg n "$name" '.packs[] | select(.key == $k) | .manifests[] | select(.name == $n) | .content' "$a") \
            <(jq -r --arg k "$key" --arg n "$name" '.packs[] | select(.key == $k) | .manifests[] | select(.name == $n) | .content' "$b") || true
        done
    done
}

cmd_compare() {
  local a="" b="" json="" full=""
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      --full) full=1; shift ;;
      --color) set_color always; shift ;;
      --color=*) set_color "${1#--color=}"; shift ;;
      --no-color) set_color never; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) if [ -z "$a" ]; then a=$1; elif [ -z "$b" ]; then b=$1; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$a" ] && [ -n "$b" ] || die "compare needs two refs"
  local sa sb
  snapshot_for "$a"; sa=$SNAP
  snapshot_for "$b"; sb=$SNAP
  local d="$TMP/diff.json"
  jq -n --slurpfile sa "$sa" --slurpfile sb "$sb" "$JQ_DIFF" > "$d"
  if [ -n "$json" ]; then
    cat "$d"
  else
    jq -r --arg esc "$ESC" --argjson color "$(color_on && echo true || echo false)" "$JQ_RENDER" "$d"
    [ -n "$full" ] && full_diffs "$sa" "$sb" "$d"
  fi
  if [ "$(jq -r .same "$d")" = true ]; then return 0; else return 1; fi
}

# verify: a recorded snapshot of a published version against the live profile with the
# same uid. Exit 0 means the published version is still what was recorded; 1 means it was
# edited in place (or the snapshot is stale); 2 is an error.
cmd_verify() {
  local snap="" json=""
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      --color) set_color always; shift ;;
      --color=*) set_color "${1#--color=}"; shift ;;
      --no-color) set_color never; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$snap" ] || die "unexpected argument: $1"; snap=$1; shift ;;
    esac
  done
  [ -n "$snap" ] && [ -f "$snap" ] || die "verify needs a snapshot file"
  jq -e '.schema == "palette-profile-snapshot/1"' "$snap" >/dev/null 2>&1 \
    || die "'$snap' is not a palette-profile-diff snapshot"
  local uid name ver at
  uid=$(jq -r '.source.uid // empty' "$snap")
  [ -n "$uid" ] || die "snapshot has no source.uid to verify against"
  name=$(jq -r '.source.name' "$snap"); ver=$(jq -r '.source.version' "$snap"); at=$(jq -r '.source.fetchedAt' "$snap")
  log "verifying $name@$ver ($uid) against live; recorded $at"
  if cmd_compare ${json:+--json} "$snap" "$uid"; then
    [ -n "$json" ] || echo "$(paint '1;32' OK): published version $name@$ver is unchanged since $at"
    return 0
  else
    [ -n "$json" ] || echo "$(paint '1;31' DRIFT): published version $name@$ver differs from the copy recorded $at"
    return 1
  fi
}

main() {
  [ $# -gt 0 ] || { usage; exit 2; }
  case $1 in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
  esac
  check_deps
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/ppd.XXXXXX")
  trap 'rm -rf "$TMP"' EXIT
  case $1 in
    snapshot) shift; cmd_snapshot "$@" ;;
    compare)  shift; cmd_compare "$@" ;;
    verify)   shift; cmd_verify "$@" ;;
    *)        cmd_compare "$@" ;;
  esac
}

main "$@"
