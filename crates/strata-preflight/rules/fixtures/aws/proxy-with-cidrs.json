                  "export HTTPS_PROXY=http://proxy.example.com:3128",
                  "export NO_PROXY=127.0.0.1,localhost,169.254.169.254,.svc,.cluster.local,192.168.0.0/16,10.96.0.0/12,10.0.0.0/16"
                ]
