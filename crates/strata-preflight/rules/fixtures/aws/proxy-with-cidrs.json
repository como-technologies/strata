            "values": "pack:\n  podCIDR: \"192.168.0.0/16\"\n  serviceClusterIpRange: \"10.96.0.0/12\"\nkubeadmconfig:\n  clusterConfiguration:\n    networking:\n      podSubnet: \"192.168.0.0/16\"\n      serviceSubnet: \"10.96.0.0/12\"\n",
