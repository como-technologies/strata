{
  "_base": "clean.json",
  "_note": "the account lists the region of the entity among its enabled regions",
  "_patch": {
    "_responses": {
      "GET /v1/clouds/aws/regions?cloudAccountUid=acc-eks-1": {
        "ok": true,
        "status": 200,
        "body": {
          "regions": [
            { "name": "us-east-1", "endpoint": "ec2.us-east-1.amazonaws.com" },
            { "name": "us-east-2", "endpoint": "ec2.us-east-2.amazonaws.com" },
            { "name": "us-west-2", "endpoint": "ec2.us-west-2.amazonaws.com" }
          ]
        }
      }
    }
  }
}
