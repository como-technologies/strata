            { "clusterVersion": "1.34", "clusterType": "eks", "defaultVersion": false, "status": "STANDARD_SUPPORT", "kubernetesPatchVersion": "1.34.11" },
            { "clusterVersion": "1.33", "clusterType": "eks", "defaultVersion": false, "status": "EXTENDED_SUPPORT", "kubernetesPatchVersion": "1.33.13" },
            { "clusterVersion": "1.32", "clusterType": "eks", "defaultVersion": false, "status": "EXTENDED_SUPPORT", "kubernetesPatchVersion": "1.32.13" }
          ]
        },
        "stderr": ""
      }
    }
