# --- github.com/github/gitignore/blob/main/Rust.gitignore -----------------------------------

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock stays tracked on purpose: this crate ships binaries, and the template says to keep
# it for an executable. See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# --- this repository ------------------------------------------------------------------------

# transient files written by the tool and the example fetcher
.packs.json
*.tmp
_entity.raw.json
*.jsonl

# local credentials never belong here
.env
*.env

# live example: state and real variable values stay local; runs hold raw API responses
examples/live/terraform/.terraform/
examples/live/terraform/*.tfstate
examples/live/terraform/*.tfstate.*
examples/live/terraform/.terraform.tfstate.lock.info
examples/live/terraform/terraform.tfvars
examples/live/runs/

# examples: `just examples` builds these offline from the fetched pack data, which stays tracked
examples/INDEX.md
examples/packs/*/*
!examples/packs/*/_entity.json
!examples/packs/*/_summaries.json
examples/profiles/
examples/clusters/
examples/reports/

# the library example resolves its own dependencies
examples/library/Cargo.lock

# the knurl adapter is its own package, and it resolves its own dependencies too
adapter/Cargo.lock

# the book: `just docs` builds it
docs/book/

# records written by hand while walking a use case; the book keeps its own under docs/
/addons/
/releases/
/runs/
/candidate.json
/comment.md
